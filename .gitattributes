# Ensure consistent line endings
* text=auto

# Use LF for JavaScript, CSS, HTML, and JSON files
*.js   text eol=lf
*.jsx  text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.css  text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf

# Keep binary files untouched
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.svg  binary
*.woff binary
*.ttf  binary